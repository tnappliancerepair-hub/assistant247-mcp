{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assistant247.net/kit/business.schema.json",
  "title": "Business facts file (business.json) v0.1",
  "description": "A small public file at /.well-known/business.json that states a business's own facts. Spec: https://assistant247.net/kit/spec (CC BY 4.0).",
  "type": "object",
  "required": [
    "name",
    "updated"
  ],
  "anyOf": [
    {
      "required": [
        "phone"
      ]
    },
    {
      "required": [
        "website"
      ]
    },
    {
      "required": [
        "email"
      ]
    },
    {
      "required": [
        "booking"
      ]
    }
  ],
  "properties": {
    "spec": {
      "type": "string",
      "format": "uri"
    },
    "spec_version": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "category": {
      "type": "string",
      "description": "schema.org type, e.g. Plumber, HVACBusiness, LocalBusiness"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phone": {
      "type": "string",
      "description": "E.164 preferred, e.g. +16155551234"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "country": {
          "type": "string"
        }
      }
    },
    "service_area": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hours": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(Mo|Tu|We|Th|Fr|Sa|Su)(-(Mo|Tu|We|Th|Fr|Sa|Su))?(,(Mo|Tu|We|Th|Fr|Sa|Su)(-(Mo|Tu|We|Th|Fr|Sa|Su))?)* ([01]\\d|2[0-4]):[0-5]\\d-([01]\\d|2[0-4]):[0-5]\\d$"
      },
      "description": "schema.org openingHours strings"
    },
    "hours_note": {
      "type": "string"
    },
    "booking": {
      "type": "object",
      "properties": {
        "phone": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "how": {
          "type": "string"
        }
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "description": "Same as schema.org sameAs"
    },
    "verified_by": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    }
  },
  "additionalProperties": true
}
